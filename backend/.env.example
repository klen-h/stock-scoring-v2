# ============================================================================
# 环境变量模板（本文件入库；真实值写在 backend/.env，已被 .gitignore 排除）
#
# 使用：cp .env.example .env 然后填入真实值
# 部署：Render 在控制台 Environment 填写（render.yaml 已列好变量名）；
#       Docker/服务器 在部署机手工创建 backend/.env（docker-compose 自动读取）
# ============================================================================

# ── LLM（诊断/复盘，SiliconFlow + DeepSeek-R1）──────────────────────────
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-R1
LLM_API_KEY=sk-你的key

# ── 金十快讯（浏览器登录 jin10.com 后复制的会话 Cookie，会过期）──────────
FLASH_COOKIE=你的cookie

# ── 企业微信推送（可选，不配只走 Web 界面 + 页面通知）────────────────────
# WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的key

# ── 可选调优 ─────────────────────────────────────────────────────────────
# LLM 每日熔断上限（默认50次/天，到顶暂停分析、事件流照常，次日自动恢复）
# LLM_DAILY_MAX_CALLS=50
# 快讯轮询间隔秒（默认300；再小注意金十限流）
# FLASH_POLL_INTERVAL_SEC=300
# 信号跟踪间隔秒（默认300，仅盘中执行）
# TRACK_INTERVAL_SEC=300
# 费用估算：元/百万token（配了 status 页自动算钱）
# LLM_PRICE_IN=4
# LLM_PRICE_OUT=16
# 重活外置开关（默认 1 = 本进程自己跑指标刷新）：
#   指标缓存刷新已迁 GitHub Actions（.github/workflows/indicator-refresh.yml，北京16:40）。
#   Render 等 0.1 CPU 环境设 0，本进程只读表算分，不再自己算 300 只 × 500 根。
# ENABLE_HEAVY_JOBS=1
#
# ── 数据源切换（Supabase egress 根治方案，见 scripts/generate_backend_pack.py）──
#   db     默认，读 Supabase 肥表（kline_cache/backtest_prices/indicator_cache）
#   pack   读 GitHub Pages 上的 backend-pack.db（SQLite，Actions 每日打包；按需查询常驻≈0）
#   local  只读本地 backend/data/pack/backend-pack.db（本地开发零流量；先跑 scripts/sync_local.py）
# DATA_SOURCE=db
# 数据包地址（pack 模式下载用；默认即 gh-pages 上的 SQLite 包）
# PACK_URL=https://klen-h.github.io/stock-scoring-v2/data/backend-pack.db.gz

# ── 数据库（默认 SQLite 本地存储，可切换 PostgreSQL 云数据库）──────────
# 不设置或留空 = SQLite（数据文件 backend/data/app.db）
# SQLite 适合单机使用，数据存在本地
# DATABASE_URL=
#
# PostgreSQL（多设备同步、云端存储，推荐 Supabase 免费套餐）
# 注册 Supabase → 新建项目 → 设置 → Database → Connection string → URI
#
# ⚠️ 安全提醒：本文件是**入库的模板**，绝不能填真实密码（仓库若公开 = 数据库公开）。
#   真实连接串只写 backend/.env（已被 .gitignore 排除）。
#   若真实密码曾误写进这里并推过远端，请立即去 Supabase 重置数据库密码。
# DATABASE_URL=postgresql://postgres:你的密码@db.你的项目.supabase.co:5432/postgres
