# ============================================================================
# 生产环境变量模板（服务器：backend/.env —— 不入库，切勿提交）
# 复制：cp backend/.env.example backend/.env 然后填真实值
# 生效：docker compose -f deploy/docker-compose.prod.yml restart
# ============================================================================

# ── 必需 ────────────────────────────────────────────────────────────────
# Supabase / Postgres 连接串（读代码清单、资金流、快照等全部表）
DATABASE_URL=postgresql://postgres:<密码>@<host>:5432/postgres

# 登录 JWT 签名密钥（换值会让所有用户被迫重新登录）
JWT_SECRET=请填一个长随机字符串

# ── 数据源：pack = 读 GitHub Pages 数据包（零回源，必须）──────────────────
DATA_SOURCE=pack
# 数据包地址（默认即 Pages，一般不用改）
# PACK_URL=https://klen-h.github.io/stock-scoring-v2/data/backend-pack.db.gz

# ── 只读模式：重活交给 GitHub Actions 日批，服务器只跑 API + 轻循环 ────────
#   关闭项：战法扫描 / 回测回填 / 资金流 / 主力行为 / 快照 / 矛盾扫描 …
#   保留项：快讯 / 持仓跟踪 / 健康检查 / 模拟盘 / 行情缓存 / 盘前盘后复盘
DEPLOY_READ_ONLY=1
ENABLE_HEAVY_JOBS=0
# 全市场行情刷新间隔（秒）——2C2G 机器建议 300，降内存尖峰
STOCK_CACHE_INTERVAL=300

# ── 前端「刷新数据/触发日批」按钮（需要 workflow 权限的 PAT）──────────────
GITHUB_TOKEN=
# GITHUB_REPO=klen-h/stock-scoring-v2        # 默认即此，通常不用填
# DAILY_BATCH_WORKFLOW=daily-batch.yml

# ── 企微推送（战法信号 / 日批告警 / 日报）─────────────────────────────────
WECHAT_WEBHOOK=
# WECHAT_BUSINESS_ALERTS=1                   # 业务告警开关（默认 0）

# ── LLM 解读（日报/矛盾报告；不填则跳过 LLM 部分，硬数据照常）────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=
# LLM_DAILY_MAX_CALLS=50                     # 每日调用上限，防超支

# ── 可选调优 ────────────────────────────────────────────────────────────
# FLASH_POLL_INTERVAL_SEC=300                # 快讯轮询间隔
# TRACK_INTERVAL_SEC=300                     # 持仓跟踪间隔
# MAINFORCE_MODE=off                         # auto 时出货信号才乘 0.85
# TRADE_GATE=on                              # 模拟盘主力闸门
# STRATEGY_MAINFORCE_GATE=on
# WARFARE_EXIT_POLICY=v2
# ZZSHARE_TOKEN=                             # 财报扩展数据源（可匿名）
# FLASH_COOKIE=                              # 金十快讯 Cookie（留空走匿名源）
# CONTRADICTION_RISK_HOOK=0                  # 宽度崩塌风控钩子（severe 次日新仓风险额减半
#                                            # + 趋势类战法暂停推送/入池；默认 0 关闭）
# WHITELIST_CRITERION=win_rate               # 战法推送白名单判据：win_rate（胜率≥55%，体系
#                                            # 天花板≈50%→恒空集）| expectancy（均收益>0.3% 且 PF≥1.2）
