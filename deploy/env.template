# ════════════════════════════════════════════════════════════════
# 腾讯云 Lighthouse 生产环境 .env 模板
# 复制为 backend/.env 后逐项填写。★ 此文件含密钥，永不入库。
# ════════════════════════════════════════════════════════════════

# ── 数据库 ──────────────────────────────────────────────────────
# 方案 B（推荐，彻底脱离 Supabase）：指向同机 Postgres 容器
DATABASE_URL=postgresql://stockapp:改我@postgres:5432/stockapp
# 方案 A 过渡期（继续用 Supabase）：填现有连接串，迁库后再切换
# DATABASE_URL=postgresql://postgres.xxx:密码@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# ★ compose 变量（Postgres 容器初始化用，密码与上面 DATABASE_URL 保持一致）
POSTGRES_DB=stockapp
POSTGRES_USER=stockapp
POSTGRES_PASSWORD=改我

# 数据读取档位：db=直连数据库 | pack/local=读数据包（本地已迁包后用）
# ★ 数据库迁到本机 Postgres 后建议 db（Postgres 在本机，无 egress 问题）
DATA_SOURCE=db

# ── LLM（DeepSeek，复盘/日报/诊断）─────────────────────────────
LLM_API_KEY=sk-填你的key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-reasoner
LLM_DAILY_MAX_CALLS=50

# ── 企微推送 ────────────────────────────────────────────────────
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=填你的key
# 业务推送开关：持仓负面消息/战法信号等（=1 恢复，此前本地缺失导致持仓负面静默）
WECHAT_BUSINESS_ALERTS=1
# 每日日报是否推企微（默认只落库，前端 /report 看）
DAILY_REPORT_PUSH=1

# ── 金十数据 ────────────────────────────────────────────────────
# 快讯监控的 Cookie（浏览器登录金十后复制）
FLASH_COOKIE=填你的cookie
JIN10_MP_APP_ID=fiXF2nOnDycGutVA

# ── zzshare（财报扩展/龙虎榜）─────────────────────────────────
ZZSHARE_TOKEN=可选，官网免费申请提升频率

# ── 主力行为体系开关 ────────────────────────────────────────────
# 排行榜出货嫌疑乘数：off 默认｜auto（观察期已过可设 auto）
MAINFORCE_MODE=auto
# 战法信号主力过滤闸门（剔高位+拉升段）
STRATEGY_MAINFORCE_GATE=on
# 退出策略 v2：持有3日/-7%止损/不设目标价
WARFARE_EXIT_POLICY=v2
# 交易门禁（买入三条件）
TRADE_GATE=on

# ── 重任务开关 ──────────────────────────────────────────────────
# 2核2G + 本机 Postgres：指标刷新/回测预热可以开（本地 IO 快）
# 若数据库仍在 Supabase：设 0 保护 egress
ENABLE_HEAVY_JOBS=1

# ── 安全 ────────────────────────────────────────────────────────
# JWT 签名密钥（必填，随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"）
JWT_SECRET=填随机长字符串
# 数据恢复密钥（浏览器镜像恢复用）
BACKUP_SECRET=填随机长字符串
JWT_EXPIRE_HOURS=720

# ── 其他（有默认值，按需覆盖）───────────────────────────────────
# PACK_URL=https://klen-h.github.io/stock-scoring-v2/data/backend-pack.db.gz
# FLASH_POLL_INTERVAL_SEC=300
# TRACK_INTERVAL_SEC=300
