# ══════════════════════════════════════════════════════════════════════════════
# systemd 服务单元（**无 Docker** 部署方案 · 宝塔 Linux 面板 · 2C2G 阿里云）
# ══════════════════════════════════════════════════════════════════════════════
# 为什么有这个文件：国内拉 Docker Hub 镜像长期不可靠（大层卡在 0B），
# 而本项目只有一个 Python 服务 ⇒ 直接用 venv + systemd 反而更稳。
#
# 安装：
#   sudo cp deploy/stock-scoring.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now stock-scoring
#   sudo systemctl status stock-scoring --no-pager
#
# 常用：
#   sudo systemctl restart stock-scoring     # 改完代码/改完 .env 后重启
#   sudo journalctl -u stock-scoring -f      # 看实时日志
#   sudo journalctl -u stock-scoring -n 100  # 看最近 100 行
#
# ⚠️ 三个必须保留项（都是 2026-11-02 排查 OOM 的成果，去掉会复发）：
#   ① MALLOC_ARENA_MAX=2      —— glibc arena 数封顶（多线程碎片不归还 OS）
#   ② ASYNCIO_POOL_WORKERS=6  —— 调度器 asyncio.to_thread 的并发闸
#   ③ --workers 1             —— **绝不能开多 worker**：进程内缓存、
#      调度器、闸门单飞锁全部是"单进程"设计，多 worker 会各自拉一套
#      （内存 ×N、定时任务重复跑、缓存互不可见）。
# ══════════════════════════════════════════════════════════════════════════════

[Unit]
Description=Stock Scoring Backend (FastAPI + uvicorn)
Documentation=https://github.com/klen-h/stock-scoring-v2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 用普通用户跑（不要 root）：该目录属主是 admin
User=admin
Group=admin
WorkingDirectory=/www/wwwroot/stock-scoring-v2/backend

# 时区：与项目全部"北京时间"口径一致（服务器默认可能是 UTC，会导致
# 阶段判定、日批窗口、`datetime.now()` 全线偏 8 小时）
Environment=TZ=Asia/Shanghai
Environment=MALLOC_ARENA_MAX=2
Environment=ASYNCIO_POOL_WORKERS=6

# 凭证：从 backend/.env 读（前面加 `-` 表示文件缺失也不阻止启动）
EnvironmentFile=-/www/wwwroot/stock-scoring-v2/backend/.env

# ★ 只绑 127.0.0.1：外网统一走 nginx 的 80 端口反代 /api
ExecStart=/www/wwwroot/stock-scoring-v2/backend/.venv/bin/uvicorn \
          app.main:app --host 127.0.0.1 --port 8000 --workers 1

Restart=always
RestartSec=5
# 崩溃后不要无限快速重启（配合内存问题排查看日志）
StartLimitIntervalSec=300
StartLimitBurst=10

# 内存兜底：2G 机器上给服务设个软上限，避免它把整机拖死（含面板/nginx）。
# 注意 MemoryMax 是**硬杀**，MemoryHigh 是**先压后杀**，这里用 High 更温和。
MemoryHigh=1600M

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
