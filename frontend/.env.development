VITE_API_BASE_URL=/api

# ★★ 2026-11-07：本地开发响应缓存。
#   开 = 同一个 GET 请求第二次直接从 localStorage 返回，**不再打后端**
#   （改前端热更新/刷新页面时，省掉评分精算、雷达、复盘聚合等重算）。
#   ⚠️ 只影响 `npm run dev`：`npm run build` / `build:server` 不读本文件 ⇒ 线上零影响。
#   ⚠️ 缓存数据**停在写入那一刻**。要看最新数据：
#        · 控制台执行 `clearApiCache()`，或
#        · 单个请求带 `params: { nocache: 1 }`
VITE_LOCAL_CACHE=1

# 可选：自动失效秒数（不写 = 永不过期）
# VITE_LOCAL_CACHE_TTL=1800
